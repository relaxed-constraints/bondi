{
  "services": {
    "mongodb": {
      "image": "mongo:8.0.16",
      "ports": ["127.0.0.1:27017:27017"],
      "volumes": ["mongodb-data:/data/db"],
      "healthcheck": {
        "test": ["CMD", "mongosh", "--quiet", "--eval", "quit(db.adminCommand({ping: 1}).ok ? 0 : 1)"],
        "interval": "2s",
        "timeout": "5s",
        "retries": 30,
        "start_period": "10s"
      }
    }
  },
  "volumes": {"mongodb-data": {}}
}
